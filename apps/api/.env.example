# ==============================================================
# TradeSim API — Environment Variables
# ==============================================================
#
# USAGE
#   cp .env.example .env
#   Fill in ALL required variables before starting the API.
#
# SECURITY RULES
#   - NEVER commit .env to git (it is in .gitignore)
#   - Use strong random values for all *_SECRET vars
#   - Generate secrets with: openssl rand -hex 32
#   - In production, inject via Docker secrets or CI env vars
#
# REQUIRED vs OPTIONAL
#   Required  — server refuses to start without these
#   Optional  — server starts with defaults; enable for full functionality
# ==============================================================

# ── Runtime ───────────────────────────────────────────────────
# development | production | test
NODE_ENV=development
PORT=3001

# ── Database ─────────────────────────────────────────────────
# [REQUIRED] Full PostgreSQL connection string
DATABASE_URL="postgresql://postgres:password@localhost:5432/tradesim?schema=public"

# ── Redis ────────────────────────────────────────────────────
# [REQUIRED] Full Redis connection string
REDIS_URL="redis://localhost:6379"

# ── JWT Authentication ────────────────────────────────────────
# [REQUIRED] Strong random secrets — NEVER use these placeholders in production
# Generate: openssl rand -hex 32
JWT_SECRET="CHANGE_ME_USE_OPENSSL_RAND_HEX_32"
JWT_REFRESH_SECRET="CHANGE_ME_USE_OPENSSL_RAND_HEX_32_DIFFERENT"

# [OPTIONAL] Token lifetimes
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ── CORS ─────────────────────────────────────────────────────
# [OPTIONAL] Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:3000

# ── Firebase (Google Auth) ────────────────────────────────────
# [OPTIONAL] Required only if Firebase auth is enabled
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Multi-line keys must use literal \n (not newlines)
FIREBASE_PRIVATE_KEY=

# ── Razorpay (Payments) ───────────────────────────────────────
# [OPTIONAL] Required only if payment features are enabled
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── Market Data ───────────────────────────────────────────────
# [OPTIONAL] Polling interval for live quotes (ms, minimum 1000)
MARKET_DATA_POLL_INTERVAL_MS=5000

# ── Rate Limiting (Throttler) ─────────────────────────────────
# [OPTIONAL] Max requests per TTL window
THROTTLE_TTL=60
THROTTLE_LIMIT=100
